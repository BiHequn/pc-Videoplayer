{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "native-player",
  "version-string": "0.1.0",
  "description": "Native PiP video player for the platform launcher",
  "builtin-baseline": "3d33b7f7a8121da6e4fa80b35618fc8e960be686",
  "supports": "windows & x64",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale"
      ]
    },
    "nlohmann-json"
  ],
  "overrides": [
    {
      "name": "ffmpeg",
      "version": "6.1.1",
      "port-version": 11
    }
  ]
}
